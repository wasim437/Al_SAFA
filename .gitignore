# Nothing in data/, figures/ or models/ is ignored — the whole point of this
# repository is that a juror can see the inputs, the outputs and the trained
# model metrics without running anything.

# Personal data. This is a scrape of the filled-in submission form and contains
# a name, email address and mobile number. It stays on disk but is kept out of a
# public repository. Nothing in the analysis reads it.
00_BRIEF/UPLODED DOCUMENT DETAILS.txt
archive/source_files/UPLODED DOCUMENT DETAILS.txt

# Nothing in _TRASH/ is part of the submission. It is kept on disk so anything
# can be recovered, but it does not belong in a public repository.
_TRASH/

# The concept film is built into UPLOAD_THESE_12_FILES/ by
# tools/build_submission_pdfs.py, copied from its source in
# submission/12_Concept_Animation_Video/. Tracking both copies stored 61 MB of
# video twice for no gain — the upload folder is regenerated, the submission
# folder is the original.
UPLOAD_THESE_12_FILES/*.mp4
